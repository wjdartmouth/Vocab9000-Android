# Copy this file to keystore.properties in the repository root.
# keystore.properties, *.jks, and *.keystore are gitignored — do not commit them.
#
# storeFile may be an absolute path, or a path relative to the repository root.
#   Relative example: upload-keystore.jks
#   Absolute example: /home/YOU/.vocab9000-keystore/upload-keystore.jks
#
# Create your own Play upload key (see SIGNING.md). Do not reuse a machine-local
# throwaway keystore as the production upload key.

storeFile=path/to/upload-keystore.jks
storePassword=REPLACE_ME
keyAlias=upload
keyPassword=REPLACE_ME
