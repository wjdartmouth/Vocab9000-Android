## Copy to local.properties (gitignored) or let Android Studio create it.
# Android Studio usually writes this file automatically when you open the project.
#
# macOS:   sdk.dir=/Users/YOU/Library/Android/sdk
# Linux:   sdk.dir=/home/YOU/Android/Sdk
# Windows: sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk
#
# CLI builds also need JDK 17 (JAVA_HOME) and then:
#   ./gradlew :app:assembleDebug
